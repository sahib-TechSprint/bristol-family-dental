---
// The one call to action, used everywhere. On mobile it pairs the Book
// Appointment pill with a click to call secondary, since most patients book
// by phone today.

import { practice } from "../content/practice";
import { bookHref, bookLabel } from "../content/nav";

interface Props {
  variant?: "dark" | "light";
  size?: "base" | "lg";
  class?: string;
  label?: string;
  callLabel?: string;
}

const {
  variant = "dark",
  size = "base",
  class: className = "",
  label = bookLabel,
  callLabel = `Call ${practice.phone.display}`,
} = Astro.props;

const pill =
  variant === "dark"
    ? "bg-black text-white"
    : "bg-white text-black";

const secondary =
  variant === "dark" ? "text-black" : "text-white";

const sizing =
  size === "lg"
    ? "px-5 py-3 md:px-8 md:py-5 text-base md:text-xl"
    : "px-6 py-3.5 text-sm md:text-base";
---

<div class={`flex flex-wrap items-center gap-3 md:gap-4 ${className}`}>
  <a
    href={bookHref}
    class={`inline-flex items-center justify-center rounded-full font-bold motion-safe:hover:scale-105 motion-safe:transition-transform ${pill} ${sizing}`}
  >
    {label}
  </a>
  <a
    href={`tel:${practice.phone.tel}`}
    class={`md:hidden inline-flex min-h-11 items-center text-sm font-semibold underline underline-offset-4 ${secondary}`}
  >
    {callLabel}
  </a>
</div>
