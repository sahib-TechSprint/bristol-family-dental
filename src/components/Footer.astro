---
import { practice } from "../content/practice";
import { navLinks, callHref, callLabel } from "../content/nav";
import { navLinksEs, callLabelEs, uiEs, uiEn } from "../i18n/es";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isEs = lang === "es";
const ui = isEs ? uiEs : uiEn;
const links = isEs ? navLinksEs : navLinks;
const fCtaLabel = isEs ? callLabelEs : callLabel;
const hoursRows = isEs ? uiEs.hours : practice.hours;
const taglineText = isEs ? "Su cuidado es nuestra prioridad." : practice.tagline;

const year = new Date().getFullYear();
---

<footer class="px-3 md:px-5 pb-3 md:pb-5 pt-1.5 md:pt-2">
  <div class="rounded-xl md:rounded-2xl bg-navy text-white px-6 py-14 md:px-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1.2fr] md:gap-8">
      <div>
        <p class="font-display text-xl md:text-2xl font-extrabold uppercase tracking-tight leading-[1.05]">
          Bristol Family<br />Dental Center
        </p>
        <p class="type-small mt-4 text-white/65">{taglineText}</p>
        <a
          href={callHref}
          class="mt-6 inline-flex items-center rounded-full bg-white px-6 py-3.5 text-sm font-bold text-navy transition-colors hover:bg-sky motion-safe:hover:scale-105 motion-safe:transition-[transform,background-color]"
        >
          {fCtaLabel}
        </a>
        <p class="type-small mt-6 max-w-xs text-white/65">{ui.licenseLine}</p>
      </div>

      <nav aria-label="Footer">
        <p class="type-eyebrow text-white/50">{ui.footerPages}</p>
        <ul class="mt-4 space-y-2.5">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/85 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="type-eyebrow text-white/50">{ui.footerHours}</p>
        <ul class="mt-4 space-y-2.5 text-sm text-white/85">
          {
            hoursRows.map((row) => (
              <li>
                <span class="block text-white/60">{row.label}</span>
                <span>{row.value}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="type-eyebrow text-white/50">{ui.footerContact}</p>
        <address class="mt-4 space-y-2.5 text-sm not-italic text-white/85">
          <p>
            {practice.address.street}<br />
            {practice.address.city}, {practice.address.state}
            {practice.address.zip}
          </p>
          <p>
            <a href={`tel:${practice.phone.tel}`} class="transition-colors hover:text-white">
              {practice.phone.display}
            </a>
          </p>
          <p class="text-white/60">{ui.faxLabel}: {practice.fax.display}</p>
          <p>
            <a href={`mailto:${practice.email}`} class="transition-colors hover:text-white break-all">
              {practice.email}
            </a>
          </p>
        </address>
      </div>
    </div>

    <p class="mt-12 border-t border-white/15 pt-8 text-xs leading-relaxed text-white/60">
      {ui.boardNotice}{" "}
      <a href="https://www.dbc.ca.gov" target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-white">www.dbc.ca.gov</a>
      {" "}(877) 729-7789.
    </p>

    <div
      class="mt-6 flex flex-col gap-2 text-xs text-white/50 md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} {practice.name}. {ui.rights}</p>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <a href={ui.privacyHref} class="underline-offset-4 transition-colors hover:text-white hover:underline">
          {ui.privacyLabel}
        </a>
        <a href={ui.termsHref} class="underline-offset-4 transition-colors hover:text-white hover:underline">
          {ui.termsLabel}
        </a>
        <a href={ui.accessibilityHref} class="underline-offset-4 transition-colors hover:text-white hover:underline">
          {ui.accessibilityLabel}
        </a>
      </p>
      <p>{ui.siteBy}</p>
    </div>
  </div>
</footer>
