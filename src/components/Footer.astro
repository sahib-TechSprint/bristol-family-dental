---
import { practice } from "../content/practice";
import { navLinks, bookHref, bookLabel } from "../content/nav";

const year = new Date().getFullYear();
---

<footer class="px-3 md:px-5 pb-3 md:pb-5 pt-1.5 md:pt-2">
  <div class="rounded-xl md:rounded-2xl bg-navy text-white px-6 py-14 md:px-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1.2fr] md:gap-8">
      <div>
        <p class="font-display text-xl md:text-2xl font-extrabold uppercase tracking-tight leading-[1.05]">
          Bristol Family<br />Dental Center
        </p>
        <p class="type-small mt-4 text-white/65">{practice.tagline}</p>
        <a
          href={bookHref}
          class="mt-6 inline-flex items-center rounded-full bg-white px-6 py-3.5 text-sm font-bold text-navy transition-colors hover:bg-sky motion-safe:hover:scale-105 motion-safe:transition-[transform,background-color]"
        >
          {bookLabel}
        </a>
      </div>

      <nav aria-label="Footer">
        <p class="type-eyebrow text-white/50">Pages</p>
        <ul class="mt-4 space-y-2.5">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/85 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={bookHref} class="text-sm text-white/85 transition-colors hover:text-white">
              {bookLabel}
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="type-eyebrow text-white/50">Hours</p>
        <ul class="mt-4 space-y-2.5 text-sm text-white/85">
          {
            practice.hours.map((row) => (
              <li>
                <span class="block text-white/60">{row.label}</span>
                <span>{row.value}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="type-eyebrow text-white/50">Contact</p>
        <address class="mt-4 space-y-2.5 text-sm not-italic text-white/85">
          <p>
            {practice.address.street}<br />
            {practice.address.city}, {practice.address.state}
            {practice.address.zip}
          </p>
          <p>
            <a href={`tel:${practice.phone.tel}`} class="transition-colors hover:text-white">
              {practice.phone.display}
            </a>
          </p>
          <p class="text-white/60">Fax: {practice.fax.display}</p>
          <p>
            <a href={`mailto:${practice.email}`} class="transition-colors hover:text-white break-all">
              {practice.email}
            </a>
          </p>
        </address>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t border-white/15 pt-8 text-xs text-white/50 md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} {practice.name}. All rights reserved.</p>
      <p>Site by Carbon Quill Media</p>
    </div>
  </div>
</footer>
