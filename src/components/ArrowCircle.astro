---
// The hand drawn circled arrow used on card links. Rotated 45 degrees
// counterclockwise so it points up and to the right.

interface Props {
  class?: string;
  dark?: boolean;
}

const { class: className = "", dark = false } = Astro.props;
---

<span
  class={`inline-flex h-9 w-9 md:h-10 md:w-10 items-center justify-center rounded-full border ${
    dark ? "border-white/60 text-white" : "border-black/40 text-black"
  } ${className}`}
>
  <svg viewBox="0 0 14 14" class="h-3.5 w-3.5 -rotate-45" fill="none" aria-hidden="true">
    <path
      d="M1 7h12m0 0L8 2m5 5L8 12"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</span>
