---
// Hand drawn inline icons. Simple strokes, no icon library.
// Each icon exists to carry information next to its label, never as decoration.

interface Props {
  name:
    | "tooth"
    | "coin"
    | "globe"
    | "family"
    | "clock"
    | "pin"
    | "phone"
    | "check"
    | "download"
    | "mail";
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;

