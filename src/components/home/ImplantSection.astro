---
// Implant dentistry section. No masking here: solid cards, real img tags,
// and a numbered process strip that tells patients what actually happens.

import { implantSection } from "../../content/home";
import ArrowCircle from "../ArrowCircle.astro";

const c = implantSection;
---

<section
  class="grid grid-cols-1 gap-1.5 px-3 pb-1.5 pt-1.5 md:grid-cols-[1.1fr_0.9fr] md:gap-2 md:px-5 md:pb-2 md:pt-2"
  aria-label="Implant dentistry"
  data-reveal-group
>
  <div class="flex flex-col gap-1.5 md:gap-2">
    <div class="rounded-xl bg-stone-50 px-6 py-10 md:rounded-2xl md:px-10 md:py-14" data-reveal>
      <p class="type-eyebrow text-black/55">{c.subtitle}</p>
      <h2 class="font-display mt-3 tracking-tight">
        {
          c.displayLines.map((line) => (
            <span class="block text-[clamp(3rem,7vw,6.5rem)] font-bold leading-[0.9]">{line}</span>
          ))
        }
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-1.5 md:gap-2" data-reveal>
      <img
        src="/images/implant-1.webp"
        alt="Cross section render of a dental implant with titanium post, abutment, and crown beside a natural tooth"
        class="aspect-[4/3] w-full rounded-xl object-cover md:rounded-2xl"
        width="640"
        height="480"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/implant-2.webp"
        alt="Clear model of a lower jaw showing a dental implant replacing a molar between natural teeth"
        class="aspect-[4/3] w-full rounded-xl object-cover md:rounded-2xl"
        width="640"
        height="480"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="flex-1 rounded-xl bg-zinc-200 px-6 py-9 md:rounded-2xl md:px-10 md:py-12" data-reveal>
      <p class="type-eyebrow text-black/65">{c.consultLabel}</p>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-5">
        <h3 class="type-h2 max-w-sm">{c.consultHeading}</h3>
        <a
          href="/book"
          class="inline-flex items-center rounded-full bg-white px-6 py-3.5 text-sm font-bold md:text-base motion-safe:hover:scale-105 motion-safe:transition-transform"
        >
          {c.consultCta}
        </a>
      </div>

      <ol class="mt-9 grid grid-cols-1 gap-5 border-t border-black/10 pt-8 sm:grid-cols-3">
        {
          c.processSteps.map((step) => (
            <li class="flex gap-3.5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-black/30 text-xs font-bold">
                {step.number}
              </span>
              <span>
                <span class="type-small block font-bold">{step.title}</span>
                <span class="type-small mt-1 block text-black/65">{step.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div
    class="relative min-h-[440px] overflow-hidden rounded-xl md:min-h-0 md:rounded-2xl"
    data-reveal
  >
    <img
      src="/images/patient.webp"
      alt="Smiling patient with healthy teeth after treatment"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-x-0 bottom-0 grid grid-cols-1 gap-1.5 p-1.5 md:grid-cols-2 md:gap-2 md:p-2">
      <a
        href={c.overlayCards[0].href}
        class="flex items-center justify-between gap-3 rounded-lg bg-white px-4 py-4 md:rounded-xl md:px-5 md:py-5 motion-safe:transition-transform motion-safe:hover:scale-[1.02]"
      >
        <span class="font-display text-sm font-bold leading-snug md:text-base">
          {c.overlayCards[0].title}
        </span>
        <ArrowCircle />
      </a>
      <a
        href={c.overlayCards[1].href}
        class="flex items-center justify-between gap-3 rounded-lg bg-white/60 px-4 py-4 text-black backdrop-blur-xl md:rounded-xl md:px-5 md:py-5 motion-safe:transition-transform motion-safe:hover:scale-[1.02]"
      >
        <span class="font-display text-sm font-bold leading-snug md:text-base">
          {c.overlayCards[1].title}
        </span>
        <ArrowCircle />
      </a>
    </div>
  </div>
</section>
