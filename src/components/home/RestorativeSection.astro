---
// Restorative dentistry section: solid cards, real img tags, and a numbered
// strip that tells patients what actually happens when a tooth is repaired or
// replaced. It replaced the implant section in October 2026 (implants are not
// offered until a dentist who places them joins the practice).

import { restorativeSection } from "../../content/home";
import { callHref, callLabel as callLabelEn } from "../../content/nav";
import ArrowCircle from "../ArrowCircle.astro";

interface Props {
  content?: typeof restorativeSection;
  ctaLabel?: string;
  alts?: { first: string; second: string; tall: string };
  ariaLabel?: string;
}

const {
  content: c = restorativeSection,
  ctaLabel = callLabelEn,
  ariaLabel = "Restorative dentistry",
  alts = {
    first: restorativeSection.images.first.alt,
    second: restorativeSection.images.second.alt,
    tall: restorativeSection.images.tall.alt,
  },
} = Astro.props;
---

<section
  class="grid grid-cols-1 gap-1.5 px-3 pb-1.5 pt-1.5 md:grid-cols-[1.1fr_0.9fr] md:gap-2 md:px-5 md:pb-2 md:pt-2"
  aria-label={ariaLabel}
  data-reveal-group
>
  <div class="flex flex-col gap-1.5 md:gap-2">
    <div class="rounded-xl bg-sky px-6 py-10 md:rounded-2xl md:px-10 md:py-14" data-reveal>
      <p class="type-eyebrow text-ink/60">{c.subtitle}</p>
      <h2 class="font-display mt-3 tracking-tight">
        {
          c.displayLines.map((line) => (
            <span class="block text-[clamp(3rem,7vw,6.5rem)] font-bold leading-[0.9]">{line}</span>
          ))
        }
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-1.5 md:gap-2" data-reveal>
      <img
        src={c.images.first.src}
        alt={alts.first}
        class="depth-card aspect-[4/3] w-full rounded-xl object-cover md:rounded-2xl"
        width="1280"
        height="956"
        loading="lazy"
        decoding="async"
      />
      <img
        src={c.images.second.src}
        alt={alts.second}
        class="depth-card aspect-[4/3] w-full rounded-xl object-cover md:rounded-2xl"
        width="1280"
        height="956"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="flex-1 rounded-xl bg-mist px-6 py-9 md:rounded-2xl md:px-10 md:py-12" data-reveal>
      <p class="type-eyebrow text-ink/65">{c.consultLabel}</p>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-5">
        <h3 class="type-h2 max-w-sm">{c.consultHeading}</h3>
        <a
          href={callHref}
          class="inline-flex items-center rounded-full bg-cobalt px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-cobalt-deep motion-safe:hover:scale-105 motion-safe:transition-[transform,background-color] md:text-base"
        >
          {ctaLabel}
        </a>
      </div>

      <ol class="mt-9 grid grid-cols-1 gap-5 border-t border-ink/10 pt-8 sm:grid-cols-3">
        {
          c.processSteps.map((step) => (
            <li class="flex gap-3.5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink/30 text-xs font-bold">
                {step.number}
              </span>
              <span>
                <span class="type-small block font-bold">{step.title}</span>
                <span class="type-small mt-1 block text-ink/65">{step.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div
    class="depth-card relative min-h-[440px] overflow-hidden rounded-xl bg-navy md:min-h-0 md:rounded-2xl"
    data-reveal
  >
    <img
      src={c.images.tall.src}
      alt={alts.tall}
      width="1344"
      height="2016"
      class="depth-drift absolute inset-0 h-full w-full object-cover object-[center_35%]"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-x-0 bottom-0 grid grid-cols-1 gap-1.5 p-1.5 md:grid-cols-2 md:gap-2 md:p-2">
      <a
        href={c.overlayCards[0].href}
        class="flex items-center justify-between gap-3 rounded-lg bg-white px-4 py-4 md:rounded-xl md:px-5 md:py-5 motion-safe:transition-transform motion-safe:hover:scale-[1.02]"
      >
        <span class="font-display text-sm font-bold leading-snug md:text-base">
          {c.overlayCards[0].title}
        </span>
        <ArrowCircle />
      </a>
      <a
        href={c.overlayCards[1].href}
        class="flex items-center justify-between gap-3 rounded-lg bg-sky/60 px-4 py-4 text-ink backdrop-blur-xl md:rounded-xl md:px-5 md:py-5 motion-safe:transition-transform motion-safe:hover:scale-[1.02]"
      >
        <span class="font-display text-sm font-bold leading-snug md:text-base">
          {c.overlayCards[1].title}
        </span>
        <ArrowCircle />
      </a>
    </div>
  </div>
</section>
