---
// Full screen opening card. One sky card carries the supporting line, the
// practice's full name as the display heading, three plain facts, the call
// to action, and (since October 2026) a clinical render: three toothbrushes
// in three sizes, the family in one picture without a face in it. The render
// sits in a panel on the right from tablet width and above the text on
// phones; it is preloaded from the head so it is the first paint's largest
// element, and the type never waits for it.

import { hero as heroEn } from "../../content/home";
import { callHref, callLabel as callLabelEn } from "../../content/nav";

interface Props {
  content?: typeof heroEn;
  srHeading?: string;
  callLabel?: string;
}

const {
  content: hero = heroEn,
  srHeading = "Bristol Family Dental Center, family dentist in Santa Ana",
  callLabel = callLabelEn,
} = Astro.props;
---

<section
  class="hero-scope flex min-h-[100svh] flex-col px-3 pb-1.5 pt-24 md:min-h-screen md:px-5 md:pb-2"
  aria-label="Welcome"
>
  <div
    class="relative flex flex-1 flex-col justify-between overflow-hidden rounded-xl bg-sky bg-[radial-gradient(90%_70%_at_100%_0%,#d7e3f4_0%,#eaf1fa_60%)] md:rounded-2xl"
  >
    <!-- The render: a panel on the right from tablet width, a band above the
         text on phones. The picture is the page's largest paint, so it is
         eager, high priority, and preloaded from the head. -->
    <div class="hero-render relative m-3 overflow-hidden rounded-lg bg-navy md:absolute md:inset-y-3 md:right-3 md:m-0 md:w-[42%] md:rounded-xl lg:w-[44%]">
      <picture>
        <source media="(max-width: 767px)" srcset={hero.image.mobileSrc} />
        <img
          src={hero.image.src}
          alt={hero.image.alt}
          width="2048"
          height="1143"
          class="hero-render-image aspect-[3/2] h-full w-full object-cover object-[62%_50%] md:aspect-auto md:object-[75%_50%]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <div class="relative flex items-start justify-between gap-6 p-5 md:w-[56%] md:p-8">
      <p class="max-w-xs text-sm font-semibold leading-snug text-ink/75 md:max-w-sm md:text-base">
        {hero.supporting}
      </p>
      <p class="hidden shrink-0 rounded-full border border-ink/20 px-4 py-2 md:block">
        <span class="type-eyebrow text-ink">{hero.corner}</span>
      </p>
    </div>

    <div class="relative flex flex-col gap-8 p-5 md:w-[56%] md:p-8">
      <div class="shrink-0">
        <p class="type-eyebrow mb-3 text-ink/65">{hero.label}</p>
        <h1 class="text-ink">
          <span class="sr-only">{srHeading}</span>
          <span aria-hidden="true" class="font-display block">
            {
              hero.displayLines.map((line) => (
                <span class="block text-[clamp(2.25rem,6.3vw,6.25rem)] font-bold leading-[0.9] tracking-tight">
                  {line}
                </span>
              ))
            }
          </span>
        </h1>
      </div>

      <div class="flex min-w-0 flex-col gap-5">
        <ul class="flex flex-wrap gap-2" aria-label="At a glance">
          {
            hero.facts.map((fact) => (
              <li class="rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-ink/80 md:text-sm">
                {fact}
              </li>
            ))
          }
          <li class="rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-ink/80 md:hidden">
            {hero.corner}
          </li>
        </ul>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={callHref}
            class="inline-flex items-center justify-center rounded-full bg-cobalt px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-cobalt-deep motion-safe:hover:scale-105 motion-safe:transition-[transform,background-color] md:px-8 md:py-4 md:text-lg"
          >
            {callLabel}
          </a>
          <a
            href={hero.secondaryHref}
            class="inline-flex min-h-11 items-center justify-center rounded-full border border-ink/30 bg-white px-5 py-3 text-sm font-bold text-ink transition-colors hover:bg-navy hover:text-white md:text-base"
          >
            {hero.secondaryLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
