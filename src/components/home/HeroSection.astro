---
// Full screen opening card. No photography by design: the practice has no
// approved photos of its own rooms yet, so the hero is typographic. One sky
// card carries the supporting line, the display wordmark, three plain facts,
// and the call to action. Static on purpose: the largest paint on the page
// ships as plain HTML with no image request in front of it.

import { hero as heroEn } from "../../content/home";
import { callHref, callLabel as callLabelEn } from "../../content/nav";

interface Props {
  content?: typeof heroEn;
  srHeading?: string;
  callLabel?: string;
}

const {
  content: hero = heroEn,
  srHeading = "Bristol Family Dental Center, family dentist in Santa Ana",
  callLabel = callLabelEn,
} = Astro.props;
---

<section
  class="flex min-h-[100svh] flex-col px-3 pb-1.5 pt-24 md:min-h-screen md:px-5 md:pb-2"
  aria-label="Welcome"
>
  <div
    class="relative flex flex-1 flex-col justify-between overflow-hidden rounded-xl bg-sky bg-[radial-gradient(90%_70%_at_100%_0%,#d7e3f4_0%,#eaf1fa_60%)] md:rounded-2xl"
  >
    <!-- The tooth mark from the favicon, drawn large and faint as the card's
         only decoration. Purely visual, hidden from assistive technology. -->
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      class="pointer-events-none absolute right-[6%] top-1/2 hidden h-[62%] w-auto -translate-y-1/2 text-navy/[0.07] md:block"
    >
      <path
        d="M7.5 3.5c-2.3 0-3.9 1.8-3.9 4.2 0 2.2 1 3.2 1.4 5 .5 2.1.6 7.8 2.5 7.8 1.7 0 1.3-5.6 2.9-5.6h.4c1.6 0 1.2 5.6 2.9 5.6 1.9 0 2-5.7 2.5-7.8.4-1.8 1.4-2.8 1.4-5 0-2.4-1.6-4.2-3.9-4.2-1.7 0-2.5 1.1-3.7 1.1s-2-1.1-3.7-1.1Z"
        fill="none"
        stroke="currentColor"
        stroke-width="0.9"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

    <div class="relative flex items-start justify-between gap-6 p-5 md:p-8">
      <p class="max-w-xs text-sm font-semibold leading-snug text-ink/75 md:max-w-sm md:text-base">
        {hero.supporting}
      </p>
      <p class="hidden shrink-0 rounded-full border border-ink/20 px-4 py-2 md:block">
        <span class="type-eyebrow text-ink">{hero.corner}</span>
      </p>
    </div>

    <div class="relative flex flex-col gap-8 p-5 md:flex-row md:items-end md:justify-between md:gap-10 md:p-8">
      <div class="min-w-0">
        <p class="type-eyebrow mb-3 text-ink/65">{hero.label}</p>
        <h1 class="text-ink">
          <span class="sr-only">{srHeading}</span>
          <span aria-hidden="true" class="font-display block">
            {
              hero.displayLines.map((line) => (
                <span class="block text-[clamp(3.5rem,13vw,12rem)] font-bold leading-[0.82] tracking-tight">
                  {line}
                </span>
              ))
            }
          </span>
        </h1>
      </div>

      <div class="flex shrink-0 flex-col gap-5 md:items-end">
        <ul class="flex flex-wrap gap-2 md:justify-end" aria-label="At a glance">
          {
            hero.facts.map((fact) => (
              <li class="rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-ink/80 md:text-sm">
                {fact}
              </li>
            ))
          }
          <li class="rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-ink/80 md:hidden">
            {hero.corner}
          </li>
        </ul>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={callHref}
            class="inline-flex items-center justify-center rounded-full bg-cobalt px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-cobalt-deep motion-safe:hover:scale-105 motion-safe:transition-[transform,background-color] md:px-8 md:py-4 md:text-lg"
          >
            {callLabel}
          </a>
          <a
            href={hero.secondaryHref}
            class="inline-flex min-h-11 items-center justify-center rounded-full border border-ink/30 bg-white px-5 py-3 text-sm font-bold text-ink transition-colors hover:bg-navy hover:text-white md:text-base"
          >
            {hero.secondaryLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
