---
// Patient reviews: live verified platform badges that link out to each
// listing. No review text is reproduced on the site; the platforms own that
// content and the practice has not licensed it. Numbers live in
// content/reviews.ts with their verification date.

import { reviewBadges, reviewsSection } from "../../content/reviews";

interface Props {
  section?: typeof reviewsSection;
  countLabels?: Record<string, string>;
  badgeNote?: string;
  readLabel?: string;
}

const {
  section: s = reviewsSection,
  countLabels,
  badgeNote,
  readLabel = "Read reviews on",
} = Astro.props;
---

<section class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2" aria-labelledby="reviews-heading" data-reveal-group>
  <div class="rounded-xl bg-sky px-6 py-14 md:rounded-2xl md:px-14 md:py-20">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[1.1fr_1fr] md:gap-12">
      <div data-reveal>
        <p class="type-eyebrow text-ink/60">{s.label}</p>
        <h2 id="reviews-heading" class="type-h2 mt-4 max-w-xl">{s.heading}</h2>
        <p class="type-body-lg mt-5 max-w-lg text-ink/70">{s.body}</p>
      </div>

      <ul class="flex flex-col justify-center gap-1.5 md:gap-2" data-reveal>
        {
          reviewBadges.map((badge) => (
            <li>
              <a
                href={badge.href}
                target="_blank"
                rel="noopener"
                aria-label={`${readLabel} ${badge.platform}${badge.rating ? `, ${s.ratingAria} ${badge.rating} ${s.outOf}` : ""}, ${countLabels?.[badge.platform] ?? badge.countLabel}`}
                class="flex min-h-14 items-center justify-between gap-4 rounded-lg bg-white px-5 py-4 transition-colors hover:bg-paper md:rounded-xl"
              >
                <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                  <span class="font-display text-base font-bold md:text-lg">{badge.platform}</span>
                  <span class="text-xs text-ink/65 md:text-sm">
                    {countLabels?.[badge.platform] ?? badge.countLabel}
                    {badge.note && <span> ({badgeNote ?? badge.note})</span>}
                  </span>
                </span>
                <span class="flex shrink-0 items-center gap-2">
                  {
                    badge.rating && (
                      <span class="flex items-center gap-1.5">
                        <svg viewBox="0 0 20 20" class="h-4 w-4 text-cobalt" fill="currentColor" aria-hidden="true">
                          <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                        </svg>
                        <span class="text-sm font-bold">{badge.rating}</span>
                      </span>
                    )
                  }
                  <span aria-hidden="true" class="text-cobalt">&nearr;</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
