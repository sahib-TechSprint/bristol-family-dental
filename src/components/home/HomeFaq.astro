---
// Booking focused questions, right before the visitor reaches the location
// and closing sections. Native details/summary accordion, no JavaScript.
// The matching FAQPage JSON-LD for exactly these questions is emitted by
// the home page.

import { homeFaq as homeFaqEn, homeFaqSection as homeFaqSectionEn } from "../../content/reviews";

interface Props {
  items?: typeof homeFaqEn;
  section?: typeof homeFaqSectionEn;
}

const { items: homeFaq = homeFaqEn, section: s = homeFaqSectionEn } = Astro.props;
---

<section class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2" aria-labelledby="home-faq-heading" data-reveal-group>
  <div class="rounded-xl bg-mist px-6 py-14 md:rounded-2xl md:px-14 md:py-20">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[1fr_1.5fr] md:gap-12">
      <div data-reveal>
        <p class="type-eyebrow text-ink/65">{s.label}</p>
        <h2 id="home-faq-heading" class="type-h2 mt-4">{s.heading}</h2>
        <a
          href={s.moreHref}
          class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-cobalt underline-offset-4 hover:underline"
        >
          {s.moreLabel}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="overflow-hidden rounded-lg bg-white md:rounded-xl" data-reveal>
        {
          homeFaq.map((item) => (
            <details class="faq-item group border-b border-ink/10 last:border-b-0">
              <summary class="flex min-h-11 items-center justify-between gap-4 px-5 py-4 md:px-7 md:py-5">
                <span class="font-display text-base font-bold leading-snug md:text-lg">
                  {item.question}
                </span>
                <span
                  class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/25"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 14 14" class="h-3 w-3" fill="none">
                    <path
                      d="M7 1v12M1 7h12"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"></path>
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5 md:px-7 md:pb-6">
                <p class="text-sm leading-relaxed text-ink/70 md:max-w-3xl md:text-base">
                  {item.answer}
                </p>
                <a
                  href={item.linkHref}
                  class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-cobalt underline-offset-4 hover:underline"
                >
                  {item.linkLabel}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
