---
// The quiet closing band. Stillness on purpose: one heading, one line, one action.

import { finalCta } from "../../content/home";
import Cta from "../Cta.astro";
---

<section class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2" aria-label="Book an appointment" data-reveal-group>
  <div
    class="flex flex-col items-center rounded-xl bg-stone-50 px-5 py-14 text-center md:rounded-2xl md:px-10 md:py-24"
  >
    <h2
      class="font-display max-w-3xl text-[clamp(2.5rem,7vw,5.5rem)] font-bold leading-[0.95] tracking-tight"
      data-reveal
    >
      {finalCta.heading}
    </h2>
    <p class="mt-4 max-w-md text-base leading-relaxed text-black/70" data-reveal>
      {finalCta.sub}
    </p>
    <div class="mt-8 flex justify-center" data-reveal>
      <Cta size="lg" />
    </div>
  </div>
</section>
