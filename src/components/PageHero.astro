---
// Shared opening block for inner pages: small label, display heading,
// optional intro paragraph. Quiet by design; the home page owns the drama.
// Deliberately static: this is the largest paint on inner pages, and
// animating it would hold back LCP. Motion starts below the fold.

interface Props {
  label: string;
  heading: string;
  intro?: string;
}

const { label, heading, intro } = Astro.props;
---

<section class="px-3 md:px-5 pt-28 md:pt-40 pb-1.5 md:pb-2">
  <div class="rounded-xl md:rounded-2xl bg-sky px-6 py-14 md:px-16 md:py-24">
    <p class="type-eyebrow text-ink/60">{label}</p>
    <h1 class="type-display mt-4 max-w-4xl">{heading}</h1>
    {
      intro && (
        <p class="type-body-lg mt-6 max-w-2xl text-ink/70">
          {intro}
        </p>
      )
    }
    <slot />
  </div>
</section>
