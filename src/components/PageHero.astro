---
// Shared opening block for inner pages: small label, display heading,
// optional intro paragraph. Quiet by design; the home page owns the drama.

interface Props {
  label: string;
  heading: string;
  intro?: string;
}

const { label, heading, intro } = Astro.props;
---

<section class="px-3 md:px-5 pt-28 md:pt-36 pb-1.5 md:pb-2" data-reveal-group>
  <div class="rounded-xl md:rounded-2xl bg-stone-50 px-6 py-10 md:px-12 md:py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-black/60" data-reveal>
      {label}
    </p>
    <h1
      class="font-display mt-3 max-w-4xl text-[clamp(2.4rem,6vw,4.5rem)] font-bold leading-[1.02] tracking-tight"
      data-reveal
    >
      {heading}
    </h1>
    {
      intro && (
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-black/70 md:text-lg" data-reveal>
          {intro}
        </p>
      )
    }
    <slot />
  </div>
</section>
