---
// Orthodontics on the services page: the highlight band (render, heading,
// body, three points, the call) followed by the orthodontist's card with a
// link to his practice and the services he provides at this office.
import Cta from "./Cta.astro";
import Icon from "./Icon.astro";
import ArrowCircle from "./ArrowCircle.astro";
import { orthoHighlight as highlightEn, orthodontist as orthodontistEn } from "../content/services";
import { callHref, callLabel as callLabelEn, secondaryHref, secondaryLabel } from "../content/nav";

interface Props {
  highlight?: typeof highlightEn;
  orthodontist?: typeof orthodontistEn;
  alts?: { aligner: string; retainer: string };
  newTabLabel?: string;
  callLabel?: string;
  secondaryText?: string;
  secondaryTo?: string;
}

const {
  highlight = highlightEn,
  orthodontist = orthodontistEn,
  alts = {
    aligner: "Clinical render of a transparent clear aligner tray in cool blue light",
    retainer: "Clinical render of a clear orthodontic retainer with a thin wire on a deep blue surface",
  },
  newTabLabel = "(opens in a new tab)",
  callLabel = callLabelEn,
  secondaryText = secondaryLabel,
  secondaryTo = secondaryHref,
} = Astro.props;
---

<section
  id="orthodontics"
  class="scroll-mt-24 px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
  aria-labelledby="ortho-highlight-heading"
  data-reveal-group
>
  <div class="grid grid-cols-1 gap-1.5 md:grid-cols-[1fr_1.2fr] md:gap-2">
    <div class="depth-card relative min-h-[280px] overflow-hidden rounded-xl md:min-h-0 md:rounded-2xl" data-reveal>
      <img
        src="/images/ortho-aligner.webp"
        alt={alts.aligner}
        width="1600"
        height="1205"
        class="depth-drift absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="rounded-xl bg-navy px-6 py-12 text-white md:rounded-2xl md:px-12 md:py-16" data-reveal>
      <p class="type-eyebrow text-white/55">{highlight.label}</p>
      <h2 id="ortho-highlight-heading" class="type-h2 mt-4 max-w-lg">
        {highlight.heading}
      </h2>
      <p class="type-body-lg mt-5 max-w-xl text-white/70">{highlight.body}</p>
      <ul class="mt-7 space-y-3">
        {
          highlight.points.map((point) => (
            <li class="flex items-start gap-3 text-sm text-white/85 md:text-base">
              <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-white/70" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-9">
        <Cta variant="light" label={callLabel} href={callHref} secondaryText={secondaryText} secondaryTo={secondaryTo} />
      </div>
    </div>
  </div>
</section>

<section
  class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
  aria-labelledby="orthodontist-heading"
  data-reveal-group
>
  <div class="rounded-xl bg-sky px-6 py-12 md:rounded-2xl md:px-14 md:py-16">
    <div class="grid grid-cols-1 gap-1.5 md:grid-cols-[1.2fr_1fr] md:gap-2">
      <div class="rounded-lg bg-white p-6 md:rounded-xl md:p-9" data-reveal>
        <p class="type-eyebrow text-ink/60">{orthodontist.practiceName}</p>
        <h2 id="orthodontist-heading" class="type-h2 mt-3">{orthodontist.name}, {orthodontist.title}</h2>
        <p class="mt-4 type-body text-ink/70">{orthodontist.bio}</p>
        <a
          href={orthodontist.url}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex min-h-11 items-center gap-2.5 text-sm font-bold underline-offset-4 hover:underline"
        >
          {orthodontist.linkLabel}
          <span class="sr-only"> {newTabLabel}</span>
          <ArrowCircle class="h-8 w-8" />
        </a>
      </div>
      <div class="depth-card relative min-h-[240px] overflow-hidden rounded-lg bg-navy md:min-h-0 md:rounded-xl" data-reveal>
        <img
          src="/images/ortho-retainer.webp"
          alt={alts.retainer}
          width="1600"
          height="1195"
          class="depth-drift absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <h3 class="type-h3 mt-10" data-reveal>{highlight.servicesHeading}</h3>
    <div class="mt-5 grid grid-cols-1 gap-1.5 md:grid-cols-2 md:gap-2 lg:grid-cols-3">
      {
        highlight.services.map((service) => (
          <article class="rounded-lg bg-white p-5 md:rounded-xl md:p-6" data-reveal>
            <h4 class="font-display text-lg font-bold leading-tight">{service.title}</h4>
            <p class="mt-2.5 text-sm leading-relaxed text-ink/70">{service.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
