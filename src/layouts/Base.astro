---
import "../styles/global.css";
import Navbar from "../components/Navbar.tsx";
import Splash from "../components/Splash.tsx";
import Footer from "../components/Footer.astro";
import { practice } from "../content/practice";
import { navLinks, bookHref, bookLabel } from "../content/nav";
import { navLinksEs, bookHrefEs, bookLabelEs, uiEs, uiEn } from "../i18n/es";
import { dentistSchema } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "es";
  jsonLd?: object[];
  isHome?: boolean;
  /** Path of this page's counterpart in the other language, e.g. "/es/services". */
  altPath?: string;
  noindex?: boolean;
  preloadImages?: string[];
}

const {
  title,
  description,
  lang = "en",
  jsonLd = [],
  isHome = false,
  altPath,
  noindex = false,
  preloadImages = [],
} = Astro.props;

const isEs = lang === "es";
const ui = isEs ? uiEs : uiEn;
const links = isEs ? navLinksEs : navLinks;
const navBookLabel = isEs ? bookLabelEs : bookLabel;
const navBookHref = isEs ? bookHrefEs : bookHref;
const currentPath = Astro.url.pathname;
const enUrl = isEs && altPath ? altPath : currentPath;
const esUrl = isEs ? currentPath : altPath;

const site = Astro.site ?? new URL("https://bristol-family-dental.vercel.app");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL("/og/og-default.png", site);
const ogLocale = lang === "es" ? "es_MX" : "en_US";
const schemas = [dentistSchema(site.toString()), ...jsonLd];

// Runs before first paint on the home page: covers the screen for the splash
// counter unless this session has already seen it or the visitor prefers
// reduced motion. A safety timeout clears the cover if hydration never comes.
const splashScript = `(function () {
  try {
    if (
      !sessionStorage.getItem("bfdc-splash-seen") &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      document.documentElement.classList.add("splash-hold");
      setTimeout(function () {
        document.documentElement.classList.remove("splash-hold");
      }, 4000);
    }
  } catch (e) {}
})();`;

// Staggered scroll reveal for the static sections.
const revealScript = `(function () {
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var reveal = function (items) {
    for (var i = 0; i < items.length; i++) items[i].classList.add("is-revealed");
  };
  var groups = document.querySelectorAll("[data-reveal-group]");
  if (reduced || typeof IntersectionObserver === "undefined") {
    reveal(document.querySelectorAll("[data-reveal]"));
    return;
  }
  groups.forEach(function (group) {
    var items = group.querySelectorAll("[data-reveal]");
    items.forEach(function (el, i) {
      el.style.setProperty("--reveal-delay", i * 120 + "ms");
    });
    var io = new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            reveal(items);
            io.disconnect();
            break;
          }
        }
      },
      { threshold: 0.15 }
    );
    io.observe(group);
  });
})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      altPath && esUrl && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(enUrl, site)} />
          <link rel="alternate" hreflang="es" href={new URL(esUrl, site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(enUrl, site)} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={practice.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://db.onlinewebfonts.com" crossorigin />
    <link
      href="https://db.onlinewebfonts.com/c/1cd1e7d71e048159076fd90b39846902?family=Open+Sauce+One"
      rel="stylesheet"
    />
    <link
      href="https://db.onlinewebfonts.com/c/42acf9aa4a6dc2f2886a3f682e337ead?family=Open+Sauce+One+Bold"
      rel="stylesheet"
    />

    {preloadImages.map((src) => <link rel="preload" as="image" href={src} />)}

    {isHome && <script is:inline set:html={splashScript} />}

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a
      href="#main"
      class="skip-link rounded-full bg-navy px-5 py-3 text-sm font-semibold text-white"
    >
      {ui.skipLabel}
    </a>

    {isHome && <Splash client:load />}

    <Navbar
      client:load
      links={links}
      bookLabel={navBookLabel}
      bookHref={navBookHref}
      phoneDisplay={practice.phone.display}
      phoneTel={practice.phone.tel}
      tagline={ui.tagline}
      pathname={Astro.url.pathname}
      langHref={isEs ? enUrl : (altPath ?? "/es/")}
      langLabel={ui.langLabel}
      langAria={ui.langAria}
      menuText={ui.menuText}
      openMenuLabel={ui.openMenu}
      closeMenuLabel={ui.closeMenu}
      navAria={ui.navAria}
      bookShort={isEs ? "Cita" : "Book"}
    />

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <Footer lang={lang} />

    <script is:inline set:html={revealScript} />
  </body>
</html>
