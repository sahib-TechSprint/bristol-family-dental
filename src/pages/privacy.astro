---
import Base from "../layouts/Base.astro";
import LegalPage from "../components/LegalPage.astro";
import { privacy, privacySections } from "../content/legal";
import { seo } from "../content/seo";
---

<Base title={seo.privacy.title} description={seo.privacy.description} altPath="/es/privacy">
  <LegalPage
    label={privacy.label}
    heading={privacy.heading}
    intro={privacy.intro}
    sections={privacySections}
    ariaLabel={privacy.ariaLabel}
  />
</Base>
