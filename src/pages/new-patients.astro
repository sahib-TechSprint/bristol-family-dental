---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import Icon from "../components/Icon.astro";
import { newPatients } from "../content/pages";
import { faq } from "../content/faq";
import { seo } from "../content/seo";
import { faqSchema } from "../lib/seo";
---

<Base
  title={seo.newPatients.title}
  description={seo.newPatients.description}
  jsonLd={[faqSchema(faq)]}
>
  <PageHero
    label={newPatients.label}
    heading="Welcome. Here is how your first visit works."
    intro={newPatients.expect}
  />

  <section
    class="grid grid-cols-1 gap-1.5 px-3 pb-1.5 pt-1.5 md:grid-cols-2 md:gap-2 md:px-5 md:pb-2 md:pt-2"
    aria-label="Prepare for your visit"
    data-reveal-group
  >
    <div class="rounded-xl bg-zinc-200 px-5 py-9 md:rounded-2xl md:px-8 md:py-12" data-reveal>
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">
        {newPatients.bringHeading}
      </h2>
      <ul class="mt-6 space-y-3.5">
        {
          newPatients.bring.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
              <span class="text-sm leading-snug md:text-base">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-xl bg-black px-5 py-9 text-white md:rounded-2xl md:px-8 md:py-12" data-reveal>
      <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">
        {newPatients.formsHeading}
      </h2>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-white/75 md:text-base">
        {newPatients.formsCopy}
      </p>
      <!-- Placeholder PDFs ship with the site so these links work on day one.
           The office will supply the final registration forms; replace the two
           files in public/forms/ without renaming them. -->
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={newPatients.formEn.href}
          download
          class="inline-flex items-center justify-center gap-2.5 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-black motion-safe:hover:scale-105 motion-safe:transition-transform"
        >
          <Icon name="download" class="h-4 w-4" />
          {newPatients.formEn.label}
        </a>
        <a
          href={newPatients.formEs.href}
          download
          class="inline-flex items-center justify-center gap-2.5 rounded-full border border-white/40 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white hover:text-black"
        >
          <Icon name="download" class="h-4 w-4" />
          {newPatients.formEs.label}
        </a>
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="faq-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-stone-50 px-5 py-10 md:rounded-2xl md:px-10 md:py-14">
      <h2
        id="faq-heading"
        class="font-display max-w-2xl text-[clamp(1.8rem,4vw,3rem)] font-bold leading-[1.05] tracking-tight"
        data-reveal
      >
        {newPatients.faqHeading}
      </h2>

      <div class="mt-8 overflow-hidden rounded-lg bg-white md:rounded-xl" data-reveal>
        {
          faq.map((item) => (
            <details class="faq-item group border-b border-black/10 last:border-b-0">
              <summary class="flex min-h-11 items-center justify-between gap-4 px-5 py-4 md:px-7 md:py-5">
                <span class="font-display text-base font-bold leading-snug md:text-lg">
                  {item.question}
                </span>
                <span
                  class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-black/25"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 14 14" class="h-3 w-3" fill="none">
                    <path
                      d="M7 1v12M1 7h12"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"></path>
                  </svg>
                </span>
              </summary>
              <p class="px-5 pb-5 text-sm leading-relaxed text-black/70 md:px-7 md:pb-6 md:text-base md:max-w-3xl">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>

      <div class="mt-9" data-reveal>
        <Cta />
      </div>
    </div>
  </section>
</Base>
