---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import Icon from "../components/Icon.astro";
import { doctor, team, bilingualNote } from "../content/team";
import { about } from "../content/pages";
import { seo } from "../content/seo";
import { personSchema } from "../lib/seo";

const site = (Astro.site ?? new URL("https://bristol-family-dental.vercel.app")).toString();
---

<Base title={seo.about.title} description={seo.about.description} jsonLd={[personSchema(site)]}>
  <PageHero label={about.label} heading={about.heading} intro={doctor.intro} />

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="education-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-black px-6 py-14 text-white md:rounded-2xl md:px-14 md:py-20" id="dr-begino">
      <div class="grid gap-8 md:grid-cols-[1fr_1.1fr] md:gap-12">
        <div data-reveal>
          <p class="type-eyebrow text-white/55">
            {doctor.name}
          </p>
          <h2
            id="education-heading"
            class="type-h2 mt-4"
          >
            {about.educationHeading}
          </h2>
          <p class="mt-4 type-body text-white/70">
            {doctor.educationCopy}
          </p>
        </div>

        <ol class="flex flex-col justify-center" data-reveal>
          {
            doctor.education.map((step) => (
              <li class="flex gap-5 border-b border-white/15 py-4 last:border-b-0 md:py-5">
                <span class="font-display w-14 shrink-0 text-lg font-bold md:text-xl">
                  {step.years}
                </span>
                <span>
                  <span class="block text-sm font-semibold leading-snug md:text-base">
                    {step.title}
                  </span>
                  {step.place && <span class="mt-0.5 block text-xs text-white/60 md:text-sm">{step.place}</span>}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="volunteer-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-stone-50 px-6 py-14 md:rounded-2xl md:px-14 md:py-20">
      <div class="grid gap-8 md:grid-cols-[1fr_1fr] md:gap-12">
        <div data-reveal>
          <h2
            id="volunteer-heading"
            class="type-h2"
          >
            {about.volunteerHeading}
          </h2>
          <p class="mt-4 type-body text-black/65">
            {doctor.volunteerCopy}
          </p>
        </div>
        <ul class="flex flex-col justify-center gap-3" data-reveal>
          {
            [
              "Free dental care trips to Mexico, Guatemala, and Belize",
              "Service with Puente a la Salud and La Amistad",
              "Pediatric dentistry advocacy across Orange County",
              "Care for homeless patients and local health fairs",
            ].map((item) => (
              <li class="flex items-start gap-3 rounded-lg bg-white p-4 md:rounded-xl md:p-5">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
                <span class="text-sm leading-snug md:text-base">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="team-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-zinc-200 px-6 py-14 md:rounded-2xl md:px-14 md:py-20">
      <h2
        id="team-heading"
        class="type-h2"
        data-reveal
      >
        {about.teamHeading}
      </h2>
      <p class="mt-3 max-w-xl type-body text-black/65" data-reveal>
        {bilingualNote}
      </p>

      <div class="mt-8 grid grid-cols-1 gap-1.5 sm:grid-cols-2 md:grid-cols-4 md:gap-2">
        {
          team.map((member) => (
            <div class="rounded-lg bg-white p-5 md:rounded-xl md:p-6" data-reveal>
              <h3 class="font-display text-lg font-bold leading-tight">{member.name}</h3>
              <p class="mt-1 type-eyebrow text-black/55">
                {member.role}
              </p>
              <p class="type-body mt-3 text-black/65">{member.note}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-9" data-reveal>
        <Cta />
      </div>
    </div>
  </section>
</Base>
