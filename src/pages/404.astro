---
import Base from "../layouts/Base.astro";
import { notFound } from "../content/pages";
import { practice } from "../content/practice";
import { seo } from "../content/seo";
---

<Base title={seo.notFound.title} description={seo.notFound.description} noindex>
  <section class="px-3 pb-1.5 pt-28 md:px-5 md:pb-2 md:pt-36" aria-label="Page not found">
    <div
      class="flex min-h-[60vh] flex-col items-center justify-center rounded-xl bg-stone-50 px-5 py-16 text-center md:rounded-2xl md:px-10 md:py-24"
    >
      <p class="font-display text-[clamp(4rem,14vw,9rem)] font-bold leading-none tracking-tight">
        404
      </p>
      <h1 class="font-display mt-4 max-w-2xl text-2xl font-bold tracking-tight md:text-4xl">
        {notFound.heading}
      </h1>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-black/70 md:text-base">
        {notFound.sub}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/book"
          class="inline-flex items-center rounded-full bg-black px-6 py-3.5 text-sm font-bold text-white motion-safe:hover:scale-105 motion-safe:transition-transform"
        >
          {notFound.bookCta}
        </a>
        <a
          href="/"
          class="inline-flex items-center rounded-full border border-black/30 bg-white px-6 py-3.5 text-sm font-bold transition-colors hover:bg-black hover:text-white"
        >
          {notFound.homeCta}
        </a>
      </div>
      <a
        href={`tel:${practice.phone.tel}`}
        class="mt-6 text-sm font-semibold text-black/60 underline-offset-4 hover:underline"
      >
        Or call us: {practice.phone.display}
      </a>
    </div>
  </section>
</Base>
