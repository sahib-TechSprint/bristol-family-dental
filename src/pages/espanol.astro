---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { espanol } from "../content/espanol";
import { practice } from "../content/practice";
import { seo } from "../content/seo";
import { doctor, team, teamPhoto } from "../content/team";
import { reviewBadges, reviewExcerpts } from "../content/reviews";

const equipo = [
  { name: doctor.name, role: "Lead Dentist", photo: doctor.photo, photoAlt: doctor.photoAlt },
  ...team.map(({ name, role, photo, photoAlt }) => ({ name, role, photo, photoAlt })),
];
const resenaEs = reviewExcerpts.find((excerpt) => excerpt.lang === "es");
---

<Base
  title={seo.espanol.title}
  description={seo.espanol.description}
  lang="es"
  hreflangPair
>
  <section class="px-3 pb-1.5 pt-28 md:px-5 md:pb-2 md:pt-36" aria-label="Bienvenida">
    <div class="rounded-xl bg-sky px-6 py-14 md:rounded-2xl md:px-16 md:py-24">
      <p class="type-eyebrow text-ink/60">
        {espanol.label}
      </p>
      <h1
        class="type-display mt-4 max-w-4xl"
      >
        {espanol.heading}
      </h1>
      <p class="type-body-lg mt-6 max-w-2xl text-ink/70">
        {espanol.intro}
      </p>
    </div>
  </section>

  <section
    class="grid grid-cols-1 gap-1.5 px-3 pb-1.5 pt-1.5 md:grid-cols-2 md:gap-2 md:px-5 md:pb-2 md:pt-2"
    aria-label="Servicios y seguro dental"
    data-reveal-group
  >
    <div class="rounded-xl bg-navy px-6 py-12 text-white md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <div class="flex items-center gap-3">
        <Icon name="tooth" class="h-5 w-5 text-white/70" />
        <h2 class="type-h3">
          {espanol.serviciosHeading}
        </h2>
      </div>
      <p class="mt-4 type-body text-white/75">{espanol.servicios}</p>
    </div>

    <div class="rounded-xl bg-mist px-6 py-12 md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <div class="flex items-center gap-3">
        <Icon name="coin" class="h-5 w-5 text-ink/65" />
        <h2 class="type-h3">
          {espanol.seguroHeading}
        </h2>
      </div>
      <p class="mt-4 type-body text-ink/70">{espanol.seguro}</p>
      <ul class="mt-5 flex flex-wrap gap-2.5" aria-label="Coberturas aceptadas">
        {
          ["PPO", "HMO", "Denti-Cal", "CareCredit"].map((badge) => (
            <li class="rounded-full border border-ink/25 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.1em]">
              {badge}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="grid grid-cols-1 gap-1.5 px-3 pb-1.5 pt-1.5 md:grid-cols-2 md:gap-2 md:px-5 md:pb-2 md:pt-2"
    aria-label="Horario y ubicación"
    data-reveal-group
  >
    <div class="flex flex-col rounded-xl bg-mist px-6 py-12 md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <div class="flex items-center gap-3">
        <Icon name="clock" class="h-5 w-5 text-ink/65" />
        <h2 class="type-h3">
          {espanol.horarioHeading}
        </h2>
      </div>
      <dl class="mt-6 flex-1">
        {
          espanol.horario.map((row) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-ink/10 py-3.5">
              <dt class="text-sm font-semibold">{row.label}</dt>
              <dd class="text-right text-sm text-ink/70">{row.value}</dd>
            </div>
          ))
        }
      </dl>
      <a
        href={`tel:${practice.phone.tel}`}
        class="font-display mt-6 inline-flex min-h-11 items-center text-2xl font-bold tracking-tight md:text-3xl"
      >
        {practice.phone.display}
      </a>
    </div>

    <div class="rounded-xl bg-sky px-6 py-12 md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <div class="flex items-center gap-3">
        <Icon name="pin" class="h-5 w-5 text-ink/65" />
        <h2 class="type-h3">
          {espanol.ubicacionHeading}
        </h2>
      </div>
      <p class="font-display mt-5 text-xl font-bold leading-snug md:text-2xl">
        {practice.address.street}<br />
        {practice.address.city}, {practice.address.state}
        {practice.address.zip}
      </p>
      <p class="mt-4 type-body text-ink/65">{espanol.ubicacion}</p>
      <a
        href={practice.mapsUrl}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-semibold underline underline-offset-4"
      >
        {espanol.direccionesCta}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2" aria-label="Nuestro equipo" data-reveal-group>
    <div class="rounded-xl bg-sky px-6 py-12 md:rounded-2xl md:px-14 md:py-16">
      <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-[1.1fr_1fr] md:gap-12">
        <div data-reveal>
          <p class="type-eyebrow text-ink/60">{espanol.equipoLabel}</p>
          <h2 class="type-h2 mt-4">{espanol.equipoHeading}</h2>
          <p class="type-body-lg mt-5 max-w-xl text-ink/70">{espanol.equipo}</p>
        </div>
        <img
          src={teamPhoto.src}
          alt={espanol.equipoFotoAlt}
          class="w-full rounded-lg object-cover md:rounded-xl"
          width="772"
          height="750"
          loading="lazy"
          decoding="async"
          data-reveal
        />
      </div>

      <div class="mt-8 grid grid-cols-1 gap-1.5 sm:grid-cols-2 md:gap-2 lg:grid-cols-5">
        {
          equipo.map((member) => (
            <div class="flex items-center gap-3.5 rounded-lg bg-white p-4 md:rounded-xl" data-reveal>
              <img
                src={member.photo}
                alt={member.photoAlt}
                class="h-14 w-14 shrink-0 rounded-full object-cover"
                width="56"
                height="56"
                loading="lazy"
                decoding="async"
              />
              <span>
                <span class="type-small block font-bold leading-snug">{member.name}</span>
                <span class="mt-0.5 block text-xs text-ink/65">
                  {espanol.equipoRoles[member.role] ?? member.role}
                </span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2" aria-label="Reseñas de pacientes" data-reveal-group>
    <div class="rounded-xl bg-mist px-6 py-12 md:rounded-2xl md:px-14 md:py-16">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-[1.2fr_1fr] md:gap-12">
        <div data-reveal>
          <p class="type-eyebrow text-ink/65">{espanol.resenasLabel}</p>
          <h2 class="type-h2 mt-4">{espanol.resenasHeading}</h2>
          <p class="type-body-lg mt-5 max-w-lg text-ink/70">{espanol.resenas}</p>
          {
            resenaEs && (
              <div class="mt-7 rounded-lg bg-white p-6 md:rounded-xl md:p-7">
                <span class="type-eyebrow text-cobalt">{espanol.recomendado}</span>
                <blockquote lang="es" class="font-display mt-3 text-base font-bold leading-snug md:text-lg">
                  &ldquo;{resenaEs.quote}&rdquo;
                </blockquote>
                <p class="mt-3 text-xs text-ink/65 md:text-sm">
                  {resenaEs.name} en{" "}
                  <a
                    href={resenaEs.href}
                    target="_blank"
                    rel="noopener"
                    class="font-semibold text-cobalt underline-offset-4 hover:underline"
                  >
                    {resenaEs.platform}
                  </a>
                </p>
              </div>
            )
          }
        </div>

        <ul class="flex flex-col justify-center gap-1.5 md:gap-2" data-reveal>
          {
            reviewBadges.map((badge) => (
              <li>
                <a
                  href={badge.href}
                  target="_blank"
                  rel="noopener"
                  class="flex min-h-11 items-center justify-between gap-4 rounded-lg bg-white px-5 py-4 transition-colors hover:bg-paper md:rounded-xl"
                >
                  <span class="flex items-baseline gap-2.5">
                    <span class="font-display text-base font-bold md:text-lg">{badge.platform}</span>
                    <span class="text-xs text-ink/65 md:text-sm">
                      {espanol.resenasCounts[badge.platform] ?? badge.countLabel}
                    </span>
                  </span>
                  {
                    badge.rating && (
                      <span class="flex items-center gap-1.5">
                        <svg viewBox="0 0 20 20" class="h-4 w-4 text-cobalt" fill="currentColor" aria-hidden="true">
                          <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                        </svg>
                        <span class="text-sm font-bold">{badge.rating}</span>
                      </span>
                    )
                  }
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2" aria-label="Haga su cita" data-reveal-group>
    <div
      class="flex flex-col items-center rounded-xl bg-navy px-6 py-20 text-center text-white md:rounded-2xl md:px-10 md:py-28"
      data-reveal
    >
      <h2 class="type-display max-w-3xl">
        {espanol.citaHeading}
      </h2>
      <p class="type-body-lg mt-6 max-w-xl text-white/70">{espanol.cita}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 md:gap-4">
        <a
          href="/book"
          class="inline-flex items-center rounded-full bg-white px-6 py-3.5 text-sm font-bold text-navy transition-colors hover:bg-sky motion-safe:hover:scale-105 motion-safe:transition-[transform,background-color] md:px-8 md:py-4 md:text-base"
        >
          {espanol.citaCta}
        </a>
        <a
          href={`tel:${practice.phone.tel}`}
          class="inline-flex min-h-11 items-center text-sm font-semibold underline underline-offset-4 md:text-base"
        >
          {espanol.llamarCta}: {practice.phone.display}
        </a>
      </div>
    </div>
  </section>
</Base>
