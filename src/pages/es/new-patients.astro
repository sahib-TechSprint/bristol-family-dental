---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
import Icon from "../../components/Icon.astro";
import { practice } from "../../content/practice";
import { faqSchema } from "../../lib/seo";
import { newPatientsEs, faqEs, seoEs, bookHrefEs, bookLabelEs } from "../../i18n/es";

const callLabelEs = `Llame al ${practice.phone.display}`;
---

<Base
  title={seoEs.newPatients.title}
  description={seoEs.newPatients.description}
  lang="es"
  jsonLd={[faqSchema(faqEs)]}
  altPath="/new-patients"
>
  <PageHero
    label={newPatientsEs.label}
    heading="Bienvenido. Así funciona su primera visita."
    intro={newPatientsEs.expect}
  />

  <section
    class="grid grid-cols-1 gap-1.5 px-3 pb-1.5 pt-1.5 md:grid-cols-2 md:gap-2 md:px-5 md:pb-2 md:pt-2"
    aria-label="Prepare su visita"
    data-reveal-group
  >
    <div class="rounded-xl bg-mist px-6 py-12 md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <h2 class="type-h3">
        {newPatientsEs.bringHeading}
      </h2>
      <ul class="mt-6 space-y-3.5">
        {
          newPatientsEs.bring.map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
              <span class="text-sm leading-snug md:text-base">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-xl bg-navy px-6 py-12 text-white md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <h2 class="type-h3">
        {newPatientsEs.formsHeading}
      </h2>
      <p class="mt-4 max-w-md type-body text-white/70">
        {newPatientsEs.formsCopy}
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={newPatientsEs.formEs.href}
          download
          class="inline-flex items-center justify-center gap-2.5 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-ink motion-safe:hover:scale-105 motion-safe:transition-transform"
        >
          <Icon name="download" class="h-4 w-4" />
          {newPatientsEs.formEs.label}
        </a>
        <a
          href={newPatientsEs.formEn.href}
          download
          class="inline-flex items-center justify-center gap-2.5 rounded-full border border-white/40 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white hover:text-ink"
        >
          <Icon name="download" class="h-4 w-4" />
          {newPatientsEs.formEn.label}
        </a>
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="faq-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-sky px-6 py-12 md:rounded-2xl md:px-14 md:py-16">
      <h2 id="faq-heading" class="type-h2 max-w-2xl" data-reveal>
        {newPatientsEs.faqHeading}
      </h2>

      <div class="mt-7 overflow-hidden rounded-lg bg-white md:mt-9 md:rounded-xl" data-reveal>
        {
          faqEs.map((item) => (
            <details class="faq-item group border-b border-ink/10 last:border-b-0">
              <summary class="flex min-h-11 items-center justify-between gap-4 px-5 py-4 md:px-7 md:py-5">
                <span class="font-display text-base font-bold leading-snug md:text-lg">
                  {item.question}
                </span>
                <span
                  class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-ink/25"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 14 14" class="h-3 w-3" fill="none">
                    <path
                      d="M7 1v12M1 7h12"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"></path>
                  </svg>
                </span>
              </summary>
              <p class="px-5 pb-5 text-sm leading-relaxed text-ink/70 md:px-7 md:pb-6 md:text-base md:max-w-3xl">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>

      <div class="mt-9" data-reveal>
        <Cta label={bookLabelEs} callLabel={callLabelEs} href={bookHrefEs} />
      </div>
    </div>
  </section>
</Base>
