---
import Base from "../../layouts/Base.astro";
import LegalPage from "../../components/LegalPage.astro";
import { accessibilityEs, accessibilitySectionsEs, privacyEs } from "../../i18n/legal-es";
import { seoEs } from "../../i18n/es";
---

<Base title={seoEs.accessibility.title} description={seoEs.accessibility.description} lang="es" altPath="/accessibility">
  <LegalPage
    label={accessibilityEs.label}
    heading={accessibilityEs.heading}
    intro={accessibilityEs.intro}
    sections={accessibilitySectionsEs}
    ariaLabel={accessibilityEs.ariaLabel}
    newTabLabel={privacyEs.newTab}
  />
</Base>
