---
import Base from "../../layouts/Base.astro";
import LegalPage from "../../components/LegalPage.astro";
import { privacyEs, privacySectionsEs } from "../../i18n/legal-es";
import { seoEs } from "../../i18n/es";
---

<Base title={seoEs.privacy.title} description={seoEs.privacy.description} lang="es" altPath="/privacy">
  <LegalPage
    label={privacyEs.label}
    heading={privacyEs.heading}
    intro={privacyEs.intro}
    sections={privacySectionsEs}
    ariaLabel={privacyEs.ariaLabel}
    newTabLabel={privacyEs.newTab}
  />
</Base>
