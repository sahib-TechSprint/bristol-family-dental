---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
import Icon from "../../components/Icon.astro";
import ArrowCircle from "../../components/ArrowCircle.astro";
import { dentist } from "../../content/team";
import { callHref } from "../../content/nav";
import { personSchema } from "../../lib/seo";
import {
  aboutEs,
  bilingualNoteEs,
  seoEs,
  callLabelEs,
  secondaryLabelEs,
  secondaryHrefEs,
} from "../../i18n/es";

const site = (Astro.site ?? new URL("https://bristol-family-dental.vercel.app")).toString();
---

<Base
  title={seoEs.about.title}
  description={seoEs.about.description}
  lang="es"
  jsonLd={[personSchema(site)]}
  altPath="/about"
>
  <PageHero
    label={aboutEs.label}
    heading={aboutEs.heading}
    intro={aboutEs.intro}
    image={{ src: "/images/instruments-set.webp", alt: aboutEs.heroAlt }}
  />

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="dentist-heading"
    data-reveal-group
  >
    <div class="grid grid-cols-1 gap-1.5 md:grid-cols-[1.3fr_1fr] md:gap-2" id="dentist">
      <div class="rounded-xl bg-navy px-6 py-14 text-white md:rounded-2xl md:px-14 md:py-20" data-reveal>
        <p class="type-eyebrow text-white/55">{aboutEs.dentistHeading}</p>
        <h2 id="dentist-heading" class="type-h2 mt-4">
          {dentist.name}
        </h2>
        <p class="type-small mt-3 text-white/70">{aboutEs.licenseLine}</p>
        <p class="type-body-lg mt-8 text-white/70">
          {aboutEs.dentistCopy}
        </p>
      </div>
      <div class="depth-card relative min-h-[260px] overflow-hidden rounded-xl bg-navy md:min-h-0 md:rounded-2xl" data-reveal>
        <img
          src="/images/crown-mirror.webp"
          alt={aboutEs.dentistImageAlt}
          width="1600"
          height="1195"
          class="depth-drift absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="ortho-heading"
    data-reveal-group
  >
    <div class="grid grid-cols-1 gap-1.5 md:grid-cols-[1fr_1.3fr] md:gap-2">
      <div class="depth-card relative min-h-[260px] overflow-hidden rounded-xl bg-navy md:min-h-0 md:rounded-2xl" data-reveal>
        <img
          src="/images/ortho-braces.webp"
          alt="Ilustración clínica de un modelo dental transparente con frenos de cerámica sobre una superficie azul oscuro"
          width="1600"
          height="1205"
          class="depth-drift absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="rounded-xl bg-sky px-6 py-14 md:rounded-2xl md:px-14 md:py-20" data-reveal>
        <h2 id="ortho-heading" class="type-h2">
          {aboutEs.orthoHeading}
        </h2>
        <p class="mt-4 type-body text-ink/65">
          {aboutEs.orthoCopy}
        </p>
        <a
          href={aboutEs.orthoHref}
          class="mt-6 inline-flex min-h-11 items-center gap-2.5 text-sm font-bold underline-offset-4 hover:underline"
        >
          {aboutEs.orthoLink}
          <ArrowCircle class="h-8 w-8" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="family-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-mist px-6 py-14 md:rounded-2xl md:px-14 md:py-20">
      <div class="grid gap-8 md:grid-cols-[1fr_1fr] md:gap-12">
        <div data-reveal>
          <h2 id="family-heading" class="type-h2">
            {aboutEs.familyHeading}
          </h2>
          <p class="mt-4 type-body text-ink/65">
            {aboutEs.familyCopy}
          </p>
          <p class="mt-3 type-body text-ink/65">{bilingualNoteEs}</p>
        </div>
        <ul class="flex flex-col justify-center gap-3" data-reveal>
          {
            aboutEs.familyPoints.map((item) => (
              <li class="flex items-start gap-3 rounded-lg bg-white p-4 md:rounded-xl md:p-5">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
                <span class="text-sm leading-snug md:text-base">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-9" data-reveal>
        <Cta label={callLabelEs} href={callHref} secondaryText={secondaryLabelEs} secondaryTo={secondaryHrefEs} />
      </div>
    </div>
  </section>
</Base>
