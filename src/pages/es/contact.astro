---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
import Icon from "../../components/Icon.astro";
import { practice } from "../../content/practice";
import { contactEs, seoEs, uiEs, bookHrefEs, bookLabelEs } from "../../i18n/es";

const callLabelEs = `Llame al ${practice.phone.display}`;
---

<Base title={seoEs.contact.title} description={seoEs.contact.description} lang="es" altPath="/contact">
  <PageHero
    label={contactEs.label}
    heading={contactEs.heading}
    intro={uiEs.landmarks}
  />

  <section
    class="grid grid-cols-1 gap-1.5 px-3 pb-1.5 pt-1.5 md:grid-cols-2 md:gap-2 md:px-5 md:pb-2 md:pt-2"
    aria-label="Datos de contacto y horario"
    data-reveal-group
  >
    <div class="rounded-xl bg-navy px-6 py-12 text-white md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <h2 class="type-h3">
        {contactEs.findUsHeading}
      </h2>

      <div class="mt-6 space-y-5">
        <div class="flex items-start gap-3">
          <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-white/70" />
          <p class="font-display text-lg font-bold leading-snug md:text-xl">
            {practice.address.street}<br />
            {practice.address.city}, {practice.address.state}
            {practice.address.zip}
          </p>
        </div>

        <div class="flex items-start gap-3">
          <Icon name="phone" class="mt-1 h-5 w-5 shrink-0 text-white/70" />
          <p>
            <a
              href={`tel:${practice.phone.tel}`}
              class="type-h3 transition-colors hover:text-white/75"
            >
              {practice.phone.display}
            </a>
            <span class="mt-0.5 block text-sm text-white/60">{uiEs.faxLabel}: {practice.fax.display}</span>
          </p>
        </div>

        <div class="flex items-start gap-3">
          <Icon name="mail" class="mt-1 h-5 w-5 shrink-0 text-white/70" />
          <a
            href={`mailto:${practice.email}`}
            class="break-all text-sm font-semibold underline-offset-4 hover:underline md:text-base"
          >
            {practice.email}
          </a>
        </div>
      </div>

      <a
        href={practice.mapsUrl}
        target="_blank"
        rel="noopener"
        class="mt-7 inline-flex min-h-11 items-center gap-2 text-sm font-semibold underline underline-offset-4 transition-colors hover:text-white/70"
      >
        {contactEs.directionsCta}
        <span aria-hidden="true">&rarr;</span>
      </a>

      <div class="mt-7">
        <Cta variant="light" label={bookLabelEs} callLabel={callLabelEs} href={bookHrefEs} />
      </div>
    </div>

    <div class="flex flex-col rounded-xl bg-mist px-6 py-12 md:rounded-2xl md:px-10 md:py-16" data-reveal>
      <div class="flex items-center gap-3">
        <Icon name="clock" class="h-5 w-5 text-ink/65" />
        <h2 class="type-h3">
          {contactEs.hoursHeading}
        </h2>
      </div>

      <dl class="mt-6 flex-1">
        {
          uiEs.hours.map((row) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-ink/10 py-3.5">
              <dt class="text-sm font-semibold">{row.label}</dt>
              <dd class="text-right text-sm text-ink/70">{row.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 text-xs leading-relaxed text-ink/65">{uiEs.hoursNote}</p>
    </div>
  </section>

  <section class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2" aria-label="Mapa" data-reveal-group>
    <div class="overflow-hidden rounded-xl bg-mist md:rounded-2xl" data-reveal>
      <iframe
        src={practice.mapsEmbedUrl}
        title={contactEs.mapTitle}
        class="block h-[420px] w-full"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>
