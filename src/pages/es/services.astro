---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Cta from "../../components/Cta.astro";
import Icon from "../../components/Icon.astro";
import ArrowCircle from "../../components/ArrowCircle.astro";
import { practice } from "../../content/practice";
import {
  serviceGroupsEs,
  specialistNetworkEs,
  orthoHighlightEs,
  servicesAltsEs,
  seoEs,
  bookHrefEs,
  bookLabelEs,
} from "../../i18n/es";

const callLabelEs = `Llame al ${practice.phone.display}`;
---

<Base title={seoEs.services.title} description={seoEs.services.description} lang="es" altPath="/services">
  <PageHero
    image={{ src: "/images/services-hero.webp", alt: servicesAltsEs.hero }}
    label="Servicios"
    heading="Cada sonrisa, cada etapa, un solo consultorio"
    intro="Desde la primera limpieza de un niño hasta una restauración completa, casi todo lo hacemos aquí mismo, y coordinamos especialistas de confianza para lo demás. Cada tratamiento comienza con una explicación sencilla de lo que recomendamos y por qué."
  />

  {
    serviceGroupsEs.map((group) => (
      <section
        class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
        aria-labelledby={`group-${group.id}`}
        data-reveal-group
      >
        <div class="rounded-xl bg-sky px-6 py-12 md:rounded-2xl md:px-14 md:py-16">
          <div class="max-w-2xl" data-reveal>
            <h2 id={`group-${group.id}`} class="type-h2">
              {group.name}
            </h2>
            <p class="mt-3 type-body text-ink/65">{group.intro}</p>
          </div>

          <div class="mt-7 grid grid-cols-1 gap-1.5 md:mt-9 md:grid-cols-2 md:gap-2">
            {group.services.map((service) => (
              <article
                id={service.id}
                class="flex flex-col rounded-lg bg-white p-5 md:rounded-xl md:p-7"
                data-reveal
              >
                <h3 class="type-h3">{service.name}</h3>
                <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink/70">{service.blurb}</p>
                <p class="mt-4 type-eyebrow text-ink/60">Para quién es</p>
                <p class="mt-1 text-sm text-ink/70">{service.whoFor}</p>
                <a
                  href={bookHrefEs}
                  class="mt-5 inline-flex min-h-11 items-center gap-2.5 text-sm font-bold underline-offset-4 hover:underline"
                >
                  {bookLabelEs}
                  <ArrowCircle class="h-8 w-8 md:h-8 md:w-8" />
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="ortho-highlight-heading"
    data-reveal-group
  >
    <div class="grid grid-cols-1 gap-1.5 md:grid-cols-[1fr_1.2fr] md:gap-2">
      <div class="relative min-h-[280px] overflow-hidden rounded-xl md:min-h-0 md:rounded-2xl" data-reveal>
        <img
          src="/images/ortho-aligner.webp"
          alt={servicesAltsEs.aligner}
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="rounded-xl bg-navy px-6 py-12 text-white md:rounded-2xl md:px-12 md:py-16" data-reveal>
        <p class="type-eyebrow text-white/55">{orthoHighlightEs.label}</p>
        <h2 id="ortho-highlight-heading" class="type-h2 mt-4 max-w-lg">
          {orthoHighlightEs.heading}
        </h2>
        <p class="type-body-lg mt-5 max-w-xl text-white/70">{orthoHighlightEs.body}</p>
        <ul class="mt-7 space-y-3">
          {
            orthoHighlightEs.points.map((point) => (
              <li class="flex items-start gap-3 text-sm text-white/85 md:text-base">
                <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-white/70" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-9">
          <Cta variant="light" label={bookLabelEs} callLabel={callLabelEs} href={bookHrefEs} />
        </div>
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="group-specialists"
    data-reveal-group
  >
    <div
      id={specialistNetworkEs.id}
      class="overflow-hidden rounded-xl bg-navy text-white md:rounded-2xl"
      data-reveal
    >
      <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr]">
        <div class="px-6 py-14 md:px-14 md:py-20">
          <h2 id="group-specialists" class="type-h2 max-w-xl">
            {specialistNetworkEs.name}
          </h2>
          <p class="mt-4 max-w-2xl type-body text-white/70">
            {specialistNetworkEs.blurb}
          </p>
          <div class="mt-8">
            <Cta variant="light" label={bookLabelEs} callLabel={callLabelEs} href={bookHrefEs} />
          </div>
        </div>
        <div class="relative min-h-[240px] md:min-h-0">
          <img
            src="/images/specialists.webp"
            alt={servicesAltsEs.specialists}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>
</Base>
