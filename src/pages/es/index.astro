---
import Base from "../../layouts/Base.astro";
import HeroSection from "../../components/home/HeroSection.astro";
import GallerySection from "../../components/home/GallerySection.tsx";
import RestorativeSection from "../../components/home/RestorativeSection.astro";
import WhyBristol from "../../components/home/WhyBristol.astro";
import ReviewsSection from "../../components/home/ReviewsSection.astro";
import HomeFaq from "../../components/home/HomeFaq.astro";
import FinalCta from "../../components/home/FinalCta.astro";
import { faqSchema } from "../../lib/seo";
import {
  heroEs,
  heroSrHeadingEs,
  galleryEs,
  restorativeEs,
  restorativeAltsEs,
  whyEs,
  finalCtaEs,
  reviewsSectionEs,
  reviewCountLabelsEs,
  reviewNoteEs,
  readLabelEs,
  homeFaqEs,
  homeFaqSectionEs,
  seoEs,
  callLabelEs,
  secondaryLabelEs,
  secondaryHrefEs,
} from "../../i18n/es";
import { callHref } from "../../content/nav";
import { hero } from "../../content/home";
---

<Base
  title={seoEs.home.title}
  description={seoEs.home.description}
  lang="es"
  isHome
  preloadImages={[
    { href: hero.image.mobileSrc, media: "(max-width: 767px)" },
    { href: hero.image.src, media: "(min-width: 768px)" },
  ]}
  altPath="/"
  jsonLd={[faqSchema(homeFaqEs)]}
>
  <HeroSection content={heroEs} srHeading={heroSrHeadingEs} callLabel={callLabelEs} />
  <GallerySection client:visible content={galleryEs} ctaHref={callHref} ctaLabel={callLabelEs} />
  <RestorativeSection content={restorativeEs} ctaLabel={callLabelEs} alts={restorativeAltsEs} ariaLabel="Odontología restauradora" />
  <ReviewsSection
    section={reviewsSectionEs}
    countLabels={reviewCountLabelsEs}
    badgeNote={reviewNoteEs}
    readLabel={readLabelEs}
  />
  <WhyBristol content={whyEs} />
  <HomeFaq items={homeFaqEs} section={homeFaqSectionEs} />
  <FinalCta
    content={finalCtaEs}
    ctaLabel={callLabelEs}
    ctaHref={callHref}
    secondaryText={secondaryLabelEs}
    secondaryTo={secondaryHrefEs}
  />
</Base>
