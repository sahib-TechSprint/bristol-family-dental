---
import Base from "../layouts/Base.astro";
import LegalPage from "../components/LegalPage.astro";
import { accessibility, accessibilitySections } from "../content/legal";
import { seo } from "../content/seo";
---

<Base title={seo.accessibility.title} description={seo.accessibility.description} altPath="/es/accessibility">
  <LegalPage
    label={accessibility.label}
    heading={accessibility.heading}
    intro={accessibility.intro}
    sections={accessibilitySections}
    ariaLabel={accessibility.ariaLabel}
  />
</Base>
