---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import { insurance } from "../content/pages";
import { seo } from "../content/seo";

const badges = ["PPO", "HMO", "Denti-Cal", "CareCredit"];
---

<Base title={seo.insurance.title} description={seo.insurance.description}>
  <PageHero label={insurance.label} heading={insurance.heading} intro={insurance.intro}>
    <ul class="mt-7 flex flex-wrap gap-2.5" aria-label="Accepted coverage and financing">
      {
        badges.map((badge) => (
          <li class="rounded-full border border-ink/25 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.1em] md:px-5 md:text-sm">
            {badge}
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-label="Insurance plans"
    data-reveal-group
  >
    <div class="grid grid-cols-1 gap-1.5 md:grid-cols-3 md:gap-2">
      {
        insurance.plans.map((plan) => (
          <div class="flex flex-col rounded-xl bg-sky p-6 md:rounded-2xl md:p-8" data-reveal>
            <span class="self-start rounded-full bg-navy px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.1em] text-white">
              {plan.badge}
            </span>
            <h2 class="type-h3 mt-5">{plan.name}</h2>
            <p class="type-body mt-3 text-ink/65">{plan.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="payment-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-mist px-6 py-14 md:rounded-2xl md:px-14 md:py-20">
      <h2
        id="payment-heading"
        class="type-h2 max-w-2xl"
        data-reveal
      >
        {insurance.paymentHeading}
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-1.5 md:grid-cols-3 md:gap-2">
        {
          insurance.payment.map((option) => (
            <div class="rounded-lg bg-white p-5 md:rounded-xl md:p-7" data-reveal>
              <span class="inline-block rounded-full border border-ink/25 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.1em]">
                {option.badge}
              </span>
              <h3 class="type-h3 mt-5">{option.name}</h3>
              <p class="type-body mt-3 text-ink/65">{option.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="promise-heading"
    data-reveal-group
  >
    <div class="overflow-hidden rounded-xl bg-navy text-white md:rounded-2xl" data-reveal>
      <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr]">
        <div class="px-6 py-14 md:px-14 md:py-20">
          <p class="type-eyebrow text-white/55">Working With You</p>
          <h2 id="promise-heading" class="type-h2 mt-4 max-w-xl">
            {insurance.promiseHeading}
          </h2>
          <p class="type-body-lg mt-5 max-w-2xl text-white/70">
            {insurance.promise}
          </p>
          <div class="mt-8">
            <Cta variant="light" />
          </div>
        </div>
        <div class="relative min-h-[240px] md:min-h-0">
          <img
            src="/images/insurance.webp"
            alt="Check in counter of a dental office with a folder and a small plant"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>
</Base>
