---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import { insurance } from "../content/pages";
import { seo } from "../content/seo";

const badges = ["PPO", "HMO", "Denti-Cal", "CareCredit"];
---

<Base title={seo.insurance.title} description={seo.insurance.description}>
  <PageHero label={insurance.label} heading={insurance.heading} intro={insurance.intro}>
    <ul class="mt-7 flex flex-wrap gap-2.5" aria-label="Accepted coverage and financing">
      {
        badges.map((badge) => (
          <li class="rounded-full border border-black/25 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.1em] md:px-5 md:text-sm">
            {badge}
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-label="Insurance plans"
    data-reveal-group
  >
    <div class="grid grid-cols-1 gap-1.5 md:grid-cols-3 md:gap-2">
      {
        insurance.plans.map((plan) => (
          <div class="flex flex-col rounded-xl bg-stone-50 p-6 md:rounded-2xl md:p-8" data-reveal>
            <span class="self-start rounded-full bg-black px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.1em] text-white">
              {plan.badge}
            </span>
            <h2 class="type-h3 mt-5">{plan.name}</h2>
            <p class="type-body mt-3 text-black/65">{plan.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="payment-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-zinc-200 px-6 py-14 md:rounded-2xl md:px-14 md:py-20">
      <h2
        id="payment-heading"
        class="type-h2 max-w-2xl"
        data-reveal
      >
        {insurance.paymentHeading}
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-1.5 md:grid-cols-3 md:gap-2">
        {
          insurance.payment.map((option) => (
            <div class="rounded-lg bg-white p-5 md:rounded-xl md:p-7" data-reveal>
              <span class="inline-block rounded-full border border-black/25 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.1em]">
                {option.badge}
              </span>
              <h3 class="type-h3 mt-5">{option.name}</h3>
              <p class="type-body mt-3 text-black/65">{option.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="px-3 pb-1.5 pt-1.5 md:px-5 md:pb-2 md:pt-2"
    aria-labelledby="promise-heading"
    data-reveal-group
  >
    <div class="rounded-xl bg-black px-6 py-14 text-white md:rounded-2xl md:px-14 md:py-20" data-reveal>
      <p class="type-eyebrow text-white/55">
        {insurance.promiseHeading}
      </p>
      <h2
        id="promise-heading"
        class="type-h2 mt-4 max-w-3xl"
      >
        {insurance.promise}
      </h2>
      <div class="mt-8">
        <Cta variant="light" />
      </div>
    </div>
  </section>
</Base>
