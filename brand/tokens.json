{
  "name": "Bristol Family Dental Center",
  "version": "1.0",
  "updated": "2026-08-19",
  "source": "src/styles/global.css @theme block",
  "color": {
    "navy": { "value": "#0E2A47", "role": "Primary dark surface, wordmark on light backgrounds" },
    "cobalt": { "value": "#1D5FC2", "role": "Interactive only: buttons, links, focus rings, rating stars" },
    "cobaltDeep": { "value": "#164A99", "role": "Hover and pressed states of cobalt" },
    "sky": { "value": "#EAF1FA", "role": "Light section surface" },
    "mist": { "value": "#D7E3F4", "role": "Secondary light surface" },
    "paper": { "value": "#FBFAF7", "role": "Page background" },
    "ink": { "value": "#10161F", "role": "Text on light surfaces" }
  },
  "typography": {
    "family": {
      "sans": "Open Sauce One",
      "display": "Open Sauce One Bold"
    },
    "scale": {
      "display": { "size": "clamp(2.75rem, 6vw, 4.75rem)", "lineHeight": 0.98, "letterSpacing": "-0.02em", "weight": 700 },
      "h2": { "size": "clamp(1.9rem, 3.6vw, 2.875rem)", "lineHeight": 1.05, "letterSpacing": "-0.015em", "weight": 700 },
      "h3": { "size": "1.375rem / 1.625rem", "lineHeight": 1.2, "letterSpacing": "-0.01em", "weight": 700 },
      "eyebrow": { "size": "0.6875rem / 0.75rem", "lineHeight": 1.4, "letterSpacing": "0.18em", "transform": "uppercase", "weight": 600 },
      "bodyLg": { "size": "1.0625rem / 1.125rem", "lineHeight": 1.65 },
      "body": { "size": "0.9375rem / 1rem", "lineHeight": 1.65 },
      "small": { "size": "0.8125rem / 0.875rem", "lineHeight": 1.6 }
    }
  },
  "accessibility": {
    "standard": "WCAG 2.1 AA",
    "mutedInkFloors": {
      "onSky": "ink at 60 percent opacity or stronger",
      "onMist": "ink at 65 percent opacity or stronger"
    },
    "verifiedPairs": {
      "inkOnPaper": 17.4, "inkOnSky": 15.96, "inkOnMist": 13.99,
      "whiteOnNavy": 14.57, "whiteOnCobalt": 6.06, "cobaltOnPaper": 5.8, "cobaltOnSky": 5.32
    }
  },
  "motion": {
    "reveal": "cubic-bezier(0.16, 1, 0.3, 1) over 0.6s with 120ms stagger",
    "menu": "cubic-bezier(0.76, 0, 0.24, 1) over 0.5s",
    "reducedMotion": "all animation collapses to instant"
  }
