# Public site URL. Used for canonical links, sitemap, Open Graph tags, and structured data.
PUBLIC_SITE_URL=https://bristol-family-dental.vercel.app

# Resend API key for booking notification emails.
# Leave unset in development and the booking endpoint logs requests to the console instead.
RESEND_API_KEY=

# Inbox that receives booking requests. Server side only, never shipped to the client.
BOOKING_NOTIFY_EMAIL=info@bristolfamilydentalcenter.com
